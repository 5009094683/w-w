{
  "name": "ybxlabs-website",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "ybxlabs.com: prerendered Nuxt site served from Cloudflare Workers",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "build:cloudflare": "NITRO_PRESET=cloudflare_module nuxt build",
    "build:staging": "NUXT_SITE_ENV=staging NITRO_PRESET=cloudflare_module nuxt build",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "indexnow": "node scripts/indexnow.mjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@nuxt/fonts": "^1.2.1",
    "@nuxt/image": "^2.2.1",
    "@nuxtjs/seo": "^6.1.0",
    "nuxt": "^4.7.0",
    "vue": "^3.5.46",
    "vue-router": "^5.5.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@tailwindcss/vite": "^4.3.5",
    "@takumi-rs/core": "^2.22.1",
    "eslint": "^10.15.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "unified": "^11.0.5",
    "vitest": "^5.1.2",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.168.0",
    "yaml": "^2.9.1"
  }
}
